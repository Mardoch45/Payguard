# Modèle de configuration PayGuard — copier en `.env`, jamais versionné.
# Aucune valeur réelle ne doit apparaître dans ce fichier.

# PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Doit rester l'URL sandbox : PayGuard refuse toute URL non sandbox.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Gemini via Google AI Studio, avec l'API compatible OpenAI.
# Créer une clé : https://aistudio.google.com/apikey
# Utiliser un projet Free Tier ; les quotas dépendent du compte.
# Le mode scripté fonctionne toujours sans clé ni appel réseau.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# Journal d'audit local (JSONL)
PAYGUARD_AUDIT_PATH=data/audit.jsonl
